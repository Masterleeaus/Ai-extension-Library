{
  "name": "titanzero/interaction-engine",
  "description": "Titan Zero universal interaction, wizard, LocalBrain v2 and offline intelligence engine for Laravel and WorkCore",
  "type": "laravel-module",
  "license": "proprietary",
  "require": {
    "php": "^8.2",
    "ext-json": "*",
    "ext-sodium": "*",
    "illuminate/cache": "^10.0 || ^11.0 || ^12.0",
    "illuminate/contracts": "^10.0 || ^11.0 || ^12.0",
    "illuminate/database": "^10.0 || ^11.0 || ^12.0",
    "illuminate/events": "^10.0 || ^11.0 || ^12.0",
    "illuminate/http": "^10.0 || ^11.0 || ^12.0",
    "illuminate/routing": "^10.0 || ^11.0 || ^12.0",
    "illuminate/support": "^10.0 || ^11.0 || ^12.0",
    "illuminate/view": "^10.0 || ^11.0 || ^12.0",
    "symfony/yaml": "^6.0 || ^7.0"
  },
  "autoload": {
    "psr-4": {
      "TitanZero\\Interaction\\": "src/",
      "TitanZero\\Engines\\": "src/Engines/"
    }
  },
  "scripts": {
    "test": "php tests/run.php",
    "verify": [
      "@test",
      "npm test"
    ]
  },
  "config": {
    "sort-packages": true
  }
}
