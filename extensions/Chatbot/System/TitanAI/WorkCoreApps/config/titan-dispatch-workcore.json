{
  "app_slug": "titan-dispatch",
  "app_name": "Titan Dispatch",
  "workcore_enabled": true,
  "workcore_authority": true,
  "offline_first": true,
  "domain": "dispatch",
  "workcore": {
    "read_tools": [
      "workcore.jobs.unassigned",
      "workcore.workers.availability",
      "workcore.schedule.board",
      "workcore.routes.list",
      "workcore.incidents.open"
    ],
    "action_tools": [
      "workcore.job.assign",
      "workcore.job.reassign",
      "workcore.job.reschedule",
      "workcore.route.optimise",
      "workcore.dispatch.notify"
    ],
    "requires_tenant_context": true,
    "requires_actor_context": true,
    "idempotent_actions": true,
    "confirmation_for_high_risk": true
  },
  "offline_projection": {
    "stores": [
      "dispatch_board",
      "jobs",
      "workers",
      "availability",
      "routes",
      "incidents"
    ],
    "writes_are_provisional": true,
    "sync_via": "chatbot_outbox",
    "conflicts_via": "chatbot_conflict_centre"
  },
  "governance": {
    "executor": "GovernedToolExecutor",
    "fact_verification": "WorkCoreFactVerifier",
    "risk_classification": true
  }
}
