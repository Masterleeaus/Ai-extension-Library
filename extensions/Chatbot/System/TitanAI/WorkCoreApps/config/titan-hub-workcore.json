{
  "app_slug": "titan-hub",
  "app_name": "Titan Hub",
  "workcore_enabled": true,
  "workcore_authority": true,
  "offline_first": true,
  "domain": "customer-portal",
  "workcore": {
    "read_tools": [
      "workcore.customers.show",
      "workcore.properties.show",
      "workcore.jobs.list",
      "workcore.quotes.list",
      "workcore.invoices.list",
      "workcore.payments.status"
    ],
    "action_tools": [
      "workcore.booking.create",
      "workcore.quote.request",
      "workcore.message.customer",
      "workcore.review.submit"
    ],
    "requires_tenant_context": true,
    "requires_actor_context": true,
    "idempotent_actions": true,
    "confirmation_for_high_risk": true
  },
  "offline_projection": {
    "stores": [
      "customers",
      "properties",
      "jobs",
      "quotes",
      "invoices",
      "knowledge",
      "conversations"
    ],
    "writes_are_provisional": true,
    "sync_via": "chatbot_outbox",
    "conflicts_via": "chatbot_conflict_centre"
  },
  "governance": {
    "executor": "GovernedToolExecutor",
    "fact_verification": "WorkCoreFactVerifier",
    "risk_classification": true
  }
}
