{
  "schema_version": "1.0.0",
  "identity": {
    "name": "Titan Front Desk",
    "slug": "titan-front-desk",
    "icon": "front-desk",
    "accent": "var(--lqd-ext-chat-primary)"
  },
  "navigation": {
    "default_view": "inbox",
    "primary": [
      {
        "id": "inbox",
        "label": "Inbox",
        "icon": "inbox",
        "offline": true
      },
      {
        "id": "bookings",
        "label": "Bookings",
        "icon": "bookings",
        "offline": true
      },
      {
        "id": "calls",
        "label": "Calls",
        "icon": "calls",
        "offline": true
      },
      {
        "id": "follow-ups",
        "label": "Follow-ups",
        "icon": "follow-ups",
        "offline": true
      }
    ],
    "drawer": [
      {
        "id": "customers",
        "label": "Customers",
        "icon": "chevron-right",
        "offline": true
      },
      {
        "id": "availability",
        "label": "Availability",
        "icon": "chevron-right",
        "offline": true
      },
      {
        "id": "messages",
        "label": "Messages",
        "icon": "chevron-right",
        "offline": true
      },
      {
        "id": "voicemails",
        "label": "Voicemails",
        "icon": "chevron-right",
        "offline": true
      },
      {
        "id": "escalations",
        "label": "Escalations",
        "icon": "chevron-right",
        "offline": true
      },
      {
        "id": "waiting-list",
        "label": "Waiting list",
        "icon": "chevron-right",
        "offline": true
      },
      {
        "id": "knowledge",
        "label": "Knowledge",
        "icon": "chevron-right",
        "offline": true
      },
      {
        "id": "contacts",
        "label": "Contacts",
        "icon": "chevron-right",
        "offline": true
      },
      {
        "id": "business-hours",
        "label": "Business hours",
        "icon": "chevron-right",
        "offline": true
      },
      {
        "id": "call-history",
        "label": "Call history",
        "icon": "chevron-right",
        "offline": true
      }
    ],
    "header_actions": [
      "sync",
      "notifications",
      "settings"
    ]
  },
  "home": {
    "widgets": [
      "waiting_enquiries",
      "new_bookings",
      "missed_calls",
      "follow_ups"
    ],
    "quick_actions": [
      "bookings",
      "calls"
    ]
  },
  "chat": {
    "persistent": true,
    "role": "Titan Front Desk",
    "suggested_prompts": [
      "Draft a reply",
      "Find availability",
      "Summarise this conversation"
    ],
    "context_policy": {
      "minimum_scope": true,
      "send_full_record": false,
      "requires_permission": true
    }
  },
  "workcore": {
    "domains": [
      "CRM",
      "Scheduling",
      "Support",
      "Knowledge"
    ],
    "commands": [
      "reply_enquiry",
      "create_booking",
      "create_follow_up",
      "escalate"
    ],
    "read_models": [
      "inbox_summaries",
      "booking_requests",
      "follow_ups",
      "knowledge"
    ]
  },
  "offline": {
    "records": [
      "inbox_summaries",
      "booking_requests",
      "follow_ups",
      "knowledge"
    ],
    "packs": [
      "titan-front-desk-default"
    ],
    "retention": {
      "completed_days": 30
    },
    "conflict_rules": {
      "server_authoritative": true,
      "preserve_local_copy": true
    }
  },
  "permissions": [
    "reply_enquiry",
    "create_booking",
    "create_follow_up",
    "escalate"
  ],
  "privacy": {
    "default_mode": "device-first",
    "redact_before_cloud": true,
    "attachment_confirmation": true,
    "provider_allowlist": []
  },
  "notifications": [
    "assignment",
    "approval",
    "sync_failure",
    "conflict"
  ],
  "settings_sections": [
    "ai-providers",
    "privacy",
    "device-security",
    "offline-sync",
    "workcore",
    "permissions",
    "notifications",
    "channels",
    "appearance",
    "accessibility",
    "diagnostics"
  ],
  "preview_states": [
    "mobile",
    "tablet",
    "desktop",
    "drawer-open",
    "settings-open",
    "offline",
    "syncing",
    "conflict",
    "empty",
    "populated"
  ]
}
