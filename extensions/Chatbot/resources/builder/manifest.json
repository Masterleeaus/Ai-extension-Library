{
  "id": "titan-zero-ui-builder",
  "name": "Titan Zero AI Website Builder UI",
  "version": "0.4.0",
  "authority": "presentation-only",
  "default_page": "cleaning-business-dashboard",
  "default_theme": "titan-light",
  "supported_surfaces": [
    "public-website",
    "admin-dashboard",
    "customer-portal",
    "worker-mobile",
    "property-operations",
    "reports",
    "chat",
    "canvas",
    "inline-generative-ui"
  ],
  "allowed_actions": [
    "navigate",
    "open-modal",
    "open-drawer",
    "filter",
    "search",
    "sort",
    "export-preview",
    "builder.edit",
    "workcore.customers.create",
    "workcore.properties.create",
    "workcore.jobs.create",
    "workcore.jobs.assign",
    "workcore.tasks.complete",
    "workcore.inventory.reserve",
    "titanmoney.quotes.create",
    "titanmoney.invoices.issue",
    "zeropay.payment-intent.create",
    "communications.message.send",
    "state.set",
    "state.toggle",
    "state.increment",
    "state.append",
    "state.remove",
    "ui.next-page",
    "ui.previous-page",
    "state.merge",
    "state.reset",
    "state.undo",
    "state.redo",
    "ui.expand",
    "ui.collapse",
    "ui.copy-spec",
    "ui.open-canvas",
    "form.submit-preview"
  ],
  "rules": [
    "Actions are declarative intents only.",
    "Browser totals are previews only.",
    "Generated pages use mock data until an external adapter is supplied.",
    "No component may write business records directly.",
    "No component may include credentials or provider secrets.",
    "Generated chat state may persist locally per message but is never operational truth.",
    "Version 1.0 specifications are normalised to version 1.1 before rendering.",
    "Complex interfaces should use progressive disclosure or expand to canvas.",
    "Generated UI is rendered inside chatbot messages only after server validation.",
    "Operational actions are emitted as intents and are never executed by the renderer."
  ],
  "collections": {
    "components": "components",
    "blocks": "blocks",
    "pages": "pages",
    "themes": "themes",
    "mock_data": "mock-data",
    "prompts": "prompts",
    "specs": "specs",
    "schemas": "schemas"
  },
  "generative_ui": {
    "spec_version": "1.1",
    "format": "flat-element-map",
    "inline_fence": "titan-ui",
    "max_elements": 250,
    "edit_modes": [
      "merge",
      "patch"
    ],
    "backward_compatible_versions": [
      "1.0"
    ],
    "state_persistence": "local-message-scope",
    "history": true,
    "watch_bindings": true,
    "read_data_bindings": true,
    "repair_endpoint": "/api/builder/generative-ui/repair"
  },
  "surface_profiles": {
    "chat": {
      "density": "compact",
      "max_columns": 2,
      "preferred_elements": 30,
      "expandable": true
    },
    "mobile": {
      "density": "compact",
      "max_columns": 1,
      "preferred_elements": 24,
      "expandable": false
    },
    "canvas": {
      "density": "comfortable",
      "max_columns": 4,
      "preferred_elements": 80,
      "expandable": false
    },
    "page": {
      "density": "comfortable",
      "max_columns": 4,
      "preferred_elements": 120,
      "expandable": false
    },
    "builder": {
      "density": "comfortable",
      "max_columns": 4,
      "preferred_elements": 120,
      "expandable": false
    },
    "preview": {
      "density": "comfortable",
      "max_columns": 3,
      "preferred_elements": 60,
      "expandable": true
    }
  },
  "host": "chatbot-extension-6.6",
  "offline_state": "indexeddb-ui-state-with-localstorage-fallback"
}
