APP_NAME="Ai-extensions"
APP_ENV=local
APP_KEY=base64:xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
APP_DEBUG=false
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ai_extensions
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@ai-extensions.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_HOST=api-mt1.pusher.com
PUSHER_PORT=443
PUSHER_SCHEME=https
PUSHER_APP_CLUSTER=mt1

VITE_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
VITE_PUSHER_HOST="${PUSHER_HOST}"
VITE_PUSHER_PORT="${PUSHER_PORT}"
VITE_PUSHER_SCHEME="${PUSHER_SCHEME}"
VITE_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

# Multi-Tenancy Configuration
MULTITENANT_ENABLED=true
MULTITENANT_STRICT_MODE=false
DEFAULT_COMPANY_ID=1

# API Configuration
API_RATE_LIMIT_PER_MINUTE=60
API_PAGINATION_PER_PAGE=15
API_TIMEOUT_SECONDS=30

# Feature Flags
FEATURE_KNOWLEDGE_ENGINE=true
FEATURE_VOICE_ENGINE=false
FEATURE_BOOKING_ENGINE=true
FEATURE_COMMERCE=true
FEATURE_WORKCORE=true

# External APIs
OPENAI_API_KEY=
ELEVENLABS_API_KEY=

# Messaging Services
WHATSAPP_API_URL=https://api.whatsapp.com
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_ACCESS_TOKEN=

TELEGRAM_BOT_TOKEN=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Security
ENCRYPTION_CIPHER=AES-256-CBC
SESSION_SECURE=false
SESSION_SAME_SITE=lax

# Queue/Job Configuration
QUEUE_RETRY_ATTEMPTS=3
QUEUE_RETRY_DELAY=60
JOB_TIMEOUT=300

# Webhook Configuration
WEBHOOK_RETRY_ATTEMPTS=5
WEBHOOK_TIMEOUT=30
WEBHOOK_SECRET=

# Monitoring & Observability
SENTRY_DSN=
SENTRY_ENVIRONMENT=local
ENABLE_QUERY_LOGGING=false
ENABLE_PERFORMANCE_MONITORING=false

# Database Configuration
DB_POOL_SIZE=10
DB_POOL_TIMEOUT=30

# Cache Configuration
CACHE_TTL=3600
CACHE_KEY_PREFIX=ai_extensions_

# Testing
APP_ENV_TEST=testing
DB_TEST_CONNECTION=sqlite
DB_TEST_DATABASE=:memory:
