{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://titanzero.dev/schemas/interaction/interaction-definition.v1.json",
  "title": "Titan Interaction Definition",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "id",
    "version",
    "name",
    "type",
    "capability",
    "sections"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string"
    },
    "category": {
      "type": "string"
    },
    "type": {
      "const": "wizard"
    },
    "capability": {
      "type": "string",
      "minLength": 1
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sections": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    }
  }
}
