{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://titanzero.dev/schemas/interaction/command-envelope.v1.json",
  "title": "Titan Interaction Offline Command Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "protocol_version",
    "capability",
    "payload",
    "metadata",
    "created_at"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "protocol_version": {
      "const": "1.0"
    },
    "capability": {
      "type": "string",
      "minLength": 1
    },
    "payload": {
      "type": "object"
    },
    "metadata": {
      "type": "object",
      "required": [
        "tenant_id",
        "device_id"
      ],
      "properties": {
        "tenant_id": {
          "type": "string",
          "minLength": 1
        },
        "user_id": {
          "type": [
            "string",
            "integer",
            "null"
          ]
        },
        "device_id": {
          "type": "string",
          "minLength": 1
        },
        "idempotency_key": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": true
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
