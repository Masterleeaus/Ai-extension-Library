{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://titanzero.dev/schemas/interaction/cognitive-event.v1.json",
  "title": "Titan Cognitive Event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "event_type",
    "tenant_id",
    "payload",
    "correlation_id",
    "privacy_class",
    "sequence",
    "occurred_at",
    "recorded_at"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "event_type": {
      "type": "string",
      "minLength": 1
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1
    },
    "team_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "user_id": {
      "type": [
        "string",
        "integer",
        "null"
      ]
    },
    "device_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "subject_type": {
      "type": [
        "string",
        "null"
      ]
    },
    "subject_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "interaction_run_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "wizard_run_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "payload": {
      "type": "object"
    },
    "confidence": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "evidence": {
      "type": "array"
    },
    "policy_decision": {
      "type": [
        "object",
        "null"
      ]
    },
    "model_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "parent_event_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1
    },
    "privacy_class": {
      "enum": [
        "device_private",
        "user_private",
        "tenant_private",
        "aggregate_safe"
      ]
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    }
  }
}
