{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://titanzero.dev/schemas/interaction/wizard-definition.v1.json",
  "title": "Titan Wizard Definition",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "wizard"
  ],
  "properties": {
    "wizard": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "id",
        "version",
        "name",
        "capability",
        "steps"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "capability": {
          "type": "string",
          "minLength": 1
        },
        "permissions": {
          "type": "object"
        },
        "metadata": {
          "type": "object"
        },
        "offline": {
          "type": "object"
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object"
          }
        }
      }
    }
  }
}
